<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flota_empleado_mass_update_wizard_form" model="ir.ui.view">
        <field name="name">flota.empleado.mass.update.wizard.form</field>
        <field name="model">flota.empleado.mass.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignación Masiva de Empleados">
                <sheet>
                    <div class="alert alert-info shadow-sm rounded mb-4" role="alert">
                        <i class="fa fa-info-circle me-2"/> 
                        Se aplicarán los cambios a <strong><field name="count_empleados" readonly="1"/></strong> empleado(s) seleccionado(s). Marque las casillas de los campos que desea actualizar.
                    </div>
                    
                    <group>
                        <group string="Ubicación y Departamento">
                            <label for="set_ubicacion" string="CEDI / Ubicación"/>
                            <div class="o_row">
                                <field name="set_ubicacion" class="me-2"/>
                                <field name="ubicacion_id" invisible="not set_ubicacion" required="set_ubicacion" placeholder="Seleccionar CEDI..."/>
                            </div>

                            <label for="set_ruta" string="Ruta"/>
                            <div class="o_row">
                                <field name="set_ruta" class="me-2"/>
                                <field name="ruta_id" invisible="not set_ruta" required="set_ruta" placeholder="Seleccionar Ruta..."/>
                            </div>

                            <label for="set_departamento" string="Departamento"/>
                            <div class="o_row">
                                <field name="set_departamento" class="me-2"/>
                                <field name="departamento_id" invisible="not set_departamento" required="set_departamento" placeholder="Seleccionar Departamento..."/>
                            </div>

                            <field name="departamentos_disponibles_ids" invisible="1"/>
                            <label for="set_subdepartamento" string="Subdepartamento"/>
                            <div class="o_row">
                                <field name="set_subdepartamento" class="me-2"/>
                                <field name="subdepartamento_id" invisible="not set_subdepartamento"
                                       domain="[('departamento_id', 'in', departamentos_disponibles_ids)]"
                                       options="{'no_create': True}"
                                       placeholder="Seleccionar o dejar vacío para retirar..."/>
                            </div>
                        </group>

                        <group string="Cargo y Estado">
                            <label for="set_cargo" string="Cargo"/>
                            <div class="o_row">
                                <field name="set_cargo" class="me-2"/>
                                <field name="cargo" invisible="not set_cargo" required="set_cargo" placeholder="Ej. Supervisor de Logística"/>
                            </div>

                            <label for="set_plan_datos" string="Plan de Datos"/>
                            <div class="o_row">
                                <field name="set_plan_datos" class="me-2"/>
                                <field name="plan_datos_id" invisible="not set_plan_datos" placeholder="Seleccionar Plan de Datos..."/>
                            </div>

                            <label for="set_fecha_cambiazo" string="Fecha Último Cambiazo"/>
                            <div class="o_row">
                                <field name="set_fecha_cambiazo" class="me-2"/>
                                <field name="fecha_ultimo_cambiazo" invisible="not set_fecha_cambiazo"/>
                            </div>

                            <label for="set_estado" string="Estado"/>
                            <div class="o_row">
                                <field name="set_estado" class="me-2"/>
                                <field name="estado" invisible="not set_estado" required="set_estado"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_mass_update" string="Aplicar Cambios Masivos" type="object" class="btn-primary shadow-sm"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción vinculada al menú de Acciones en la vista lista de flota.empleado -->
    <record id="action_flota_empleado_mass_update_wizard" model="ir.actions.act_window">
        <field name="name">Asignación Masiva</field>
        <field name="res_model">flota.empleado.mass.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_flota_empleado"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
