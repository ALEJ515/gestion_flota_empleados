<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Principal -->
    <record id="action_flota_empleado" model="ir.actions.act_window">
        <field name="name">Empleados y Flotas</field>
        <field name="res_model">flota.empleado</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay empleados registrados en la flota.
            </p>
            <p>
                Crea nuevos registros para gestionar nombres, departamentos, ubicaciones, cargos y números de flota telefónica.
            </p>
        </field>
    </record>

    <!-- List View con Selector de Columnas y Facturación -->
    <record id="view_flota_empleado_list" model="ir.ui.view">
        <field name="name">flota.empleado.list</field>
        <field name="model">flota.empleado</field>
        <field name="arch" type="xml">
            <list decoration-muted="estado == 'inactive' or not active">
                <field name="name"/>
                <field name="departamento_id" optional="show"/>
                <field name="ubicacion_id" optional="show"/>
                <field name="cargo" optional="show"/>
                <field name="numero_flota" optional="show"/>
                <field name="ultima_facturacion_monto" widget="monetary" string="Última Factura (RD$)" optional="show" sum="Total Facturado"/>
                <field name="ultima_facturacion_periodo" string="Periodo Factura" optional="show"/>
                <field name="estado" widget="badge" optional="show" decoration-success="estado == 'active'" decoration-warning="estado == 'draft'" decoration-danger="estado == 'inactive'"/>
                <field name="write_date" string="Última Modificación" widget="datetime" optional="hide"/>
                <field name="write_uid" string="Modificado Por" optional="hide"/>
                <field name="active" string="Archivado" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_flota_empleado_form" model="ir.ui.view">
        <field name="name">flota.empleado.form</field>
        <field name="model">flota.empleado</field>
        <field name="arch" type="xml">
            <form string="Empleado y Flota">
                <header>
                    <field name="estado" widget="statusbar" statusbar_visible="draft,active,inactive" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre Completo"/>
                        <h1>
                            <field name="name" placeholder="Ej. Karina Virginia Victoriano Vásquez"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información Laboral">
                            <field name="departamento_id" options="{'no_create_edit': False}"/>
                            <field name="ubicacion_id" options="{'no_create_edit': False}"/>
                            <field name="cargo" placeholder="Ej. Coord Integración y Capacitación"/>
                        </group>
                        <group string="Contacto y Facturación">
                            <field name="numero_flota" placeholder="Ej. 809 206-0146"/>
                            <field name="ultima_facturacion_monto" widget="monetary" readonly="1"/>
                            <field name="ultima_facturacion_periodo" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" widget="boolean_toggle" string="Activo en Sistema"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Consumo Telefónico" name="invoice_history">
                            <field name="historial_factura_linea_ids" readonly="1">
                                <list string="Historial Facturas Claro">
                                    <field name="conciliacion_id" string="Factura / Referencia" optional="show"/>
                                    <field name="periodo" string="Periodo" optional="show"/>
                                    <field name="fecha_factura" string="Fecha" optional="show"/>
                                    <field name="total_linea" widget="monetary" string="Total Línea (RD$)" sum="Total Histórico" optional="show"/>
                                    <field name="monto_renta_plan" widget="monetary" optional="hide"/>
                                    <field name="monto_uso_adicional" widget="monetary" optional="hide"/>
                                    <field name="monto_roaming" widget="monetary" optional="hide"/>
                                    <field name="subtotal_linea" widget="monetary" optional="hide"/>
                                    <field name="estado_linea" widget="badge" optional="show" decoration-success="estado_linea=='ok'" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming']" decoration-danger="estado_linea=='desconocido'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compañeros de Departamento" name="department_teammates" invisible="not departamento_id">
                            <field name="companeros_departamento_ids" readonly="1">
                                <list>
                                    <field name="name" optional="show"/>
                                    <field name="cargo" optional="show"/>
                                    <field name="numero_flota" optional="show"/>
                                    <field name="ubicacion_id" optional="show"/>
                                    <field name="ultima_facturacion_monto" widget="monetary" optional="show"/>
                                    <field name="estado" widget="badge" optional="show" decoration-success="estado == 'active'" decoration-warning="estado == 'draft'" decoration-danger="estado == 'inactive'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_flota_empleado_kanban" model="ir.ui.view">
        <field name="name">flota.empleado.kanban</field>
        <field name="model">flota.empleado</field>
        <field name="arch" type="xml">
            <kanban default_group_by="departamento_id" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="departamento_id"/>
                <field name="ubicacion_id"/>
                <field name="cargo"/>
                <field name="numero_flota"/>
                <field name="ultima_facturacion_monto"/>
                <field name="ultima_facturacion_periodo"/>
                <field name="estado"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column justify-content-between p-2">
                            <div>
                                <strong class="o_kanban_record_title fs-6 d-block mb-1">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small mb-1">
                                    <span class="fa fa-briefcase me-1" title="Cargo"/>
                                    <field name="cargo"/>
                                </div>
                                <div class="text-muted small mb-1">
                                    <span class="fa fa-map-marker me-1" title="Ubicación"/>
                                    <field name="ubicacion_id"/>
                                </div>
                                <div class="text-primary fw-bold mb-1">
                                    <span class="fa fa-phone me-1" title="Número Flota"/>
                                    <field name="numero_flota"/>
                                </div>
                                <t t-if="record.ultima_facturacion_monto.raw_value">
                                    <div class="text-success small fw-bold">
                                        Factura: RD$<t t-esc="record.ultima_facturacion_monto.value"/> (<t t-esc="record.ultima_facturacion_periodo.value"/>)
                                    </div>
                                </t>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <field name="estado" widget="badge" decoration-success="estado == 'active'" decoration-warning="estado == 'draft'" decoration-danger="estado == 'inactive'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_flota_empleado_search" model="ir.ui.view">
        <field name="name">flota.empleado.search</field>
        <field name="model">flota.empleado</field>
        <field name="arch" type="xml">
            <search string="Buscar Empleados y Flotas">
                <field name="name" string="Búsqueda Global (Nombre, Flota, Cargo, Dept, Ubic)" filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('numero_flota', 'ilike', self), ('cargo', 'ilike', self), ('departamento_id.name', 'ilike', self), ('ubicacion_id.name', 'ilike', self)]"/>
                <field name="departamento_id"/>
                <field name="ubicacion_id"/>
                <field name="numero_flota"/>
                <filter string="Activos" name="active_filter" domain="[('estado', '=', 'active')]"/>
                <filter string="Inactivos" name="inactive_filter" domain="[('estado', '=', 'inactive')]"/>
                <filter string="Borradores" name="draft_filter" domain="[('estado', '=', 'draft')]"/>
                <separator/>
                <filter string="Archivados" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Departamento" name="group_dept" context="{'group_by': 'departamento_id'}"/>
                    <filter string="Ubicación" name="group_ubi" context="{'group_by': 'ubicacion_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
