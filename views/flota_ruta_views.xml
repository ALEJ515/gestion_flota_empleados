<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_flota_ruta" model="ir.actions.act_window">
        <field name="name">Rutas</field>
        <field name="res_model">flota.ruta</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay rutas registradas.
            </p>
            <p>
                Gestiona los códigos de ruta asignados a Vendedores (ej. NTP0103) y Distribuidores (ej. DIST+10).
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_flota_ruta_list" model="ir.ui.view">
        <field name="name">flota.ruta.list</field>
        <field name="model">flota.ruta</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name" optional="show"/>
                <field name="tipo" widget="badge" optional="show"/>
                <field name="descripcion" optional="show"/>
                <field name="total_empleados" widget="badge" decoration-info="total_empleados &gt; 0" optional="show"/>
                <field name="empleados_activos_count" string="Activos" widget="badge" decoration-success="empleados_activos_count &gt; 0" optional="show"/>
                <field name="empleados_inactivos_count" string="Inactivos" widget="badge" decoration-danger="empleados_inactivos_count &gt; 0" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_flota_ruta_form" model="ir.ui.view">
        <field name="name">flota.ruta.form</field>
        <field name="model">flota.ruta</field>
        <field name="arch" type="xml">
            <form string="Ruta de Empleado">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_empleados" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="total_empleados" widget="statinfo" string="Total Empleados"/>
                        </button>
                        <button name="action_view_empleados" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="empleados_inactivos_count" widget="statinfo" string="Inactivos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactivo" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Código de Ruta"/>
                        <h1>
                            <field name="name" placeholder="Ej. NTP0103 o DIST+10"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles Generales">
                            <field name="tipo"/>
                            <field name="descripcion" placeholder="Ej. Zona Norte / Almacén 10"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Resumen de Personal">
                            <field name="total_empleados" readonly="1"/>
                            <field name="empleados_activos_count" readonly="1"/>
                            <field name="empleados_inactivos_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Asignado a esta Ruta" name="employees">
                            <field name="empleado_ids" readonly="1">
                                <list>
                                    <field name="name" optional="show"/>
                                    <field name="departamento_id" optional="show"/>
                                    <field name="cargo" optional="show"/>
                                    <field name="numero_flota" optional="show"/>
                                    <field name="estado" widget="badge" optional="show" decoration-success="estado == 'active'" decoration-warning="estado == 'draft'" decoration-danger="estado == 'inactive'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_flota_ruta_kanban" model="ir.ui.view">
        <field name="name">flota.ruta.kanban</field>
        <field name="model">flota.ruta</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="tipo"/>
                <field name="total_empleados"/>
                <field name="empleados_activos_count"/>
                <field name="empleados_inactivos_count"/>
                <field name="tiene_inactivos"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column justify-content-between p-2">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="fs-6 text-primary">
                                        <span class="fa fa-road me-1" title="Ruta"/>
                                        <field name="name"/>
                                    </strong>
                                    <span class="badge bg-light text-dark border">
                                        <field name="tipo"/>
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Total Empleados:</span>
                                    <span class="badge bg-info text-white fs-6">
                                        <field name="total_empleados"/>
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <t t-if="record.empleados_inactivos_count.raw_value &gt; 0">
                                    <span class="badge bg-danger text-white">
                                        <span class="fa fa-exclamation-triangle me-1" title="Empleados Inactivos"/> <field name="empleados_inactivos_count"/> Inactivo(s)
                                    </span>
                                </t>
                                <t t-if="record.empleados_inactivos_count.raw_value == 0">
                                    <span class="badge bg-success text-white">
                                        <span class="fa fa-check-circle me-1" title="Sin Inactivos"/> Sin Inactivos
                                    </span>
                                </t>
                                <span class="text-muted small">
                                    Activos: <field name="empleados_activos_count"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_flota_ruta_search" model="ir.ui.view">
        <field name="name">flota.ruta.search</field>
        <field name="model">flota.ruta</field>
        <field name="arch" type="xml">
            <search string="Buscar Rutas">
                <field name="name" string="Código de Ruta"/>
                <field name="descripcion"/>
                <filter string="Vendedor" name="tipo_vendedor" domain="[('tipo', '=', 'vendedor')]"/>
                <filter string="Distribuidor" name="tipo_distribuidor" domain="[('tipo', '=', 'distribuidor')]"/>
                <separator/>
                <filter string="Archivadas" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
