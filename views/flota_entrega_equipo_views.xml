<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Acta de Entrega de Equipos -->
    <record id="seq_flota_entrega_equipo" model="ir.sequence">
        <field name="name">Secuencia Acta de Entrega de Equipos</field>
        <field name="code">flota.entrega.equipo</field>
        <field name="prefix">ACT-EQ/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_flota_entrega_equipo_list" model="ir.ui.view">
        <field name="name">flota.entrega.equipo.list</field>
        <field name="model">flota.entrega.equipo</field>
        <field name="arch" type="xml">
            <list string="Actas de Entrega y Recepción de Equipos" decoration-muted="estado=='draft'">
                <field name="name" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="empleado_id" optional="show"/>
                <field name="ruta_id" optional="show"/>
                <field name="ubicacion_id" optional="show"/>
                <field name="cargo" optional="show"/>
                <field name="cantidad_equipos" optional="show"/>
                <field name="recibio_politica" optional="show"/>
                <field name="estado" widget="badge" decoration-warning="estado=='draft'" decoration-success="estado=='confirmado'" optional="show"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_flota_entrega_equipo_form" model="ir.ui.view">
        <field name="name">flota.entrega.equipo.form</field>
        <field name="model">flota.entrega.equipo</field>
        <field name="arch" type="xml">
            <form string="Acta de Recepción y Entrega de Equipos">
                <header>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary" invisible="estado != 'draft'"/>
                    <button name="action_restablecer_borrador" string="Volver a Borrador" type="object" invisible="estado != 'confirmado'"/>
                    <button name="action_descargar_pdf" string="Descargar" type="object" class="btn-secondary" icon="fa-download"/>
                    <button name="action_reasignar_empleado" string="Reasignar a Otro Empleado" type="object" class="btn-secondary" icon="fa-exchange"/>
                    <field name="estado" widget="statusbar" statusbar_visible="draft,confirmado" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_reasignaciones" type="object" class="oe_stat_button" icon="fa-exchange" invisible="reasignada_a_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Reasignada en</span>
                                <field name="reasignada_a_count" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_open_whatsapp" type="object" class="oe_stat_button o_whatsapp_stat_button" icon="fa-whatsapp" invisible="not telefono_flota">
                            <div class="o_stat_info">
                                <span class="o_stat_text">WhatsApp</span>
                                <span class="o_stat_text">Mensaje</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title mb-3" style="max-width: 100%;">
                        <label for="empleado_id" class="oe_edit_only" string="Empleado"/>
                        <h1 style="width: 100%;">
                            <field name="empleado_id" options="{'no_create_edit': True}" placeholder="Seleccione el empleado..." class="w-100"/>
                        </h1>
                        <div class="alert alert-info py-1 px-2 mb-0" role="alert" invisible="not reasignado_de_id" style="display:inline-block;">
                            <i class="fa fa-exchange me-1"/> Acta generada por reasignación de equipos desde
                            <field name="reasignado_de_id" readonly="1" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Datos Entrega">
                            <field name="cargo"/>
                            <field name="preparado_por_id"/>
                            <field name="ruta_id" options="{'no_create_edit': False}"/>
                            <field name="ubicacion_id" options="{'no_create_edit': False}"/>
                            <field name="recibido_por"/>
                            <div class="text-muted" colspan="2">
                                Nombre, cargo, ruta, localidad y teléfono están vinculados al perfil del empleado.
                                Editarlos actualiza su perfil y todas sus actas, incluidas las confirmadas.
                            </div>
                            <field name="telefono_flota"/>
                        </group>
                        <group string="Control Documental">
                            <field name="name" readonly="1"/>
                            <field name="fecha"/>
                            <field name="codigo_formulario"/>
                            <field name="version_formulario"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipo Nuevo Entregado" name="equipos">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="tipo_equipo"/>
                                    <field name="es_linea_licencia" column_invisible="1"/>
                                    <field name="marca_id" invisible="es_linea_licencia" options="{'no_create_edit': False}" placeholder="Marca..."/>
                                    <field name="modelo_id" invisible="es_linea_licencia" domain="[('marca_id', '=', marca_id)]" options="{'no_create_edit': False}" placeholder="Modelo..."/>
                                    <field name="marca" column_invisible="1"/>
                                    <field name="modelo" column_invisible="1"/>
                                    <field name="cantidad"/>
                                    <field name="imei_serial" invisible="es_linea_licencia"/>
                                    <field name="estado_equipo" readonly="es_linea_licencia"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipos Recibidos por IT (Devolución)" name="equipos_devueltos">
                            <field name="linea_devuelta_ids">
                                <list editable="bottom">
                                    <field name="tipo_equipo"/>
                                    <field name="es_linea_licencia" column_invisible="1"/>
                                    <field name="marca_id" invisible="es_linea_licencia" options="{'no_create_edit': False}" placeholder="Marca..."/>
                                    <field name="modelo_id" invisible="es_linea_licencia" domain="[('marca_id', '=', marca_id)]" options="{'no_create_edit': False}" placeholder="Modelo..."/>
                                    <field name="marca" column_invisible="1"/>
                                    <field name="modelo" column_invisible="1"/>
                                    <field name="cantidad"/>
                                    <field name="imei_serial" invisible="es_linea_licencia"/>
                                    <field name="estado_equipo" readonly="es_linea_licencia"/>
                                    <field name="observaciones"/>
                                </list>
                            </field>
                        </page>
                        <page string="Firma y Política" name="firmas">
                            <group>
                                <group string="Firmas (espacio para firma física al imprimir)">
                                    <field name="entregado_por" string="Firma Representante IT"/>
                                    <field name="recibido_por" string="Recibido o Entregado Por" readonly="1"/>
                                </group>
                                <group string="Política de Informática">
                                    <field name="recibio_politica"/>
                                    <field name="politica_qr_imagen" widget="image"/>
                                    <field name="mostrar_qr" string="Mostrar QR en el PDF"/>
                                    <field name="qr_tamano" string="Tamaño del QR" invisible="not mostrar_qr"/>
                                </group>
                            </group>
                            <group string="Aceptación y Responsabilidad (texto legal impreso en el PDF)">
                                <field name="texto_aceptacion_tamano" string="Tamaño del Texto"/>
                                <field name="texto_aceptacion" nolabel="1" colspan="2" placeholder="Escriba aquí el texto de Aceptación y Responsabilidad que debe salir en la hoja de entrega..."/>
                            </group>
                            <group>
                                <field name="notas" string="Notas Adicionales" placeholder="Notas adicionales... (se imprimen en el PDF, debajo de Aceptación y Responsabilidad)"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_flota_entrega_equipo_search" model="ir.ui.view">
        <field name="name">flota.entrega.equipo.search</field>
        <field name="model">flota.entrega.equipo</field>
        <field name="arch" type="xml">
            <search string="Buscar Actas de Entrega de Equipos">
                <field name="name" string="Búsqueda Global (Acta, Empleado, Ruta, Localidad, Cargo)" filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('empleado_id.name', 'ilike', self), ('ruta_id.name', 'ilike', self), ('ubicacion_id.name', 'ilike', self), ('cargo', 'ilike', self)]"/>
                <field name="empleado_id"/>
                <field name="ruta_id"/>
                <field name="ubicacion_id"/>
                <field name="cargo"/>
                <filter string="Borrador" name="draft_filter" domain="[('estado', '=', 'draft')]"/>
                <filter string="Confirmado" name="confirmado_filter" domain="[('estado', '=', 'confirmado')]"/>
                <separator/>
                <filter string="Este Mes" name="this_month" domain="[('fecha', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Empleado" name="group_empleado" context="{'group_by': 'empleado_id'}"/>
                    <filter string="Ruta" name="group_ruta" context="{'group_by': 'ruta_id'}"/>
                    <filter string="Ubicación" name="group_ubicacion" context="{'group_by': 'ubicacion_id'}"/>
                    <filter string="Cargo" name="group_cargo" context="{'group_by': 'cargo'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_flota_entrega_equipo" model="ir.actions.act_window">
        <field name="name">Actas de Entrega de Equipos</field>
        <field name="res_model">flota.entrega.equipo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flota_entrega_equipo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay actas de entrega de equipos registradas.
            </p>
            <p>
                Registre la recepción y entrega de equipos (celulares, tablets, laptops, impresoras) a cada empleado,
                y expórtelas a Excel o imprímalas en PDF con el formato oficial de la empresa.
            </p>
        </field>
    </record>
</odoo>
