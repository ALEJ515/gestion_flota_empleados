<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Factura Conciliación -->
    <record id="seq_flota_factura_conciliacion" model="ir.sequence">
        <field name="name">Secuencia Factura Conciliación Flota</field>
        <field name="code">flota.factura.conciliacion</field>
        <field name="prefix">FAC-CLARO/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_flota_factura_conciliacion_list" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.list</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <list string="Conciliaciones de Factura Claro" decoration-info="estado=='procesando'" decoration-success="estado=='conciliado'" decoration-danger="estado=='error'">
                <field name="name" optional="show"/>
                <field name="periodo" optional="show"/>
                <field name="proveedor" string="Proveedor" optional="show"/>
                <field name="fecha_factura" string="Fecha de Factura" optional="show"/>
                <field name="fecha_subida" string="Fecha de Subida" optional="show"/>
                <field name="count_lineas" string="Total Líneas PDF" optional="show"/>
                <field name="count_lineas_registradas" string="Total Líneas Registradas" optional="show"/>
                <field name="count_excesos" widget="badge" decoration-warning="count_excesos &gt; 0" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="subtotal" widget="monetary" sum="Subtotal Total" optional="show"/>
                <field name="itbis_monto" widget="monetary" sum="ITBIS Total" optional="show"/>
                <field name="cdt_monto" widget="monetary" sum="CDT Total" optional="show"/>
                <field name="isc_monto" widget="monetary" sum="ISC Total" optional="show"/>
                <field name="total_mes" widget="monetary" sum="Gran Total" optional="show"/>
                <field name="total_factura_pdf" widget="monetary" sum="Total PDF" optional="show"/>
                <field name="estado" widget="badge" decoration-info="estado=='procesando'" decoration-success="estado=='conciliado'" decoration-danger="estado=='error'" optional="show"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW (ANCHO COMPLETO Y ORDEN SOLICITADO) -->
    <record id="view_flota_factura_conciliacion_form" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.form</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <form string="Conciliación Financiera Factura Claro">
                <header>
                   <button name="action_procesar_pdf_nativo" string="Extraer PDF" type="object" class="btn-primary" invisible="not archivo_pdf" confirm="¿Confirma que desea extraer los datos del PDF adjunto? Esta acción reemplazará el desglose de líneas y los montos actuales de la factura. Deberá validar la información resultante antes de conciliar."/>
                   <button name="action_exportar_excel" string="Exportar" type="object" class="btn-secondary"/>
                    <field name="estado" widget="statusbar" statusbar_visible="draft,procesando,conciliado" options="{'clickable': '1'}"/>
                </header>
                <sheet class="o_full_width">
                    <div class="oe_title mb-3">
                        <label for="name" class="oe_edit_only" string="Referencia de Factura"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="periodo" placeholder="AAAA-MM (Ej. 2026-09)"/>
                        </h3>
                    </div>

                    <!-- BANNER KPIS SUPERIOR -->
                    <div class="row text-center mb-4 g-2">
                        <div class="col-md-3">
                            <div class="p-3 border rounded shadow-sm" invisible="estado_cuadre != 'cuadrado'" style="background-color:#d1f2dd;">
                                <span class="text-muted d-block small">TOTAL FACTURA CLARO</span>
                                <strong class="fs-4 text-success"><field name="total_factura_pdf" widget="monetary"/></strong>
                            </div>
                            <div class="p-3 border rounded bg-light shadow-sm" invisible="estado_cuadre == 'cuadrado'">
                                <span class="text-muted d-block small">TOTAL FACTURA CLARO</span>
                                <strong class="fs-4 text-dark"><field name="total_factura_pdf" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded shadow-sm" invisible="estado_cuadre != 'cuadrado'" style="background-color:#d1f2dd;">
                                <span class="text-muted d-block small">TOTAL DEL MES</span>
                                <strong class="fs-4 text-success"><field name="total_mes" widget="monetary"/></strong>
                            </div>
                            <div class="p-3 border rounded bg-light shadow-sm" invisible="estado_cuadre == 'cuadrado'">
                                <span class="text-muted d-block small">TOTAL DEL MES</span>
                                <strong class="fs-4 text-primary"><field name="total_mes" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">SUMA LÍNEAS EMPLEADOS</span>
                                <strong class="fs-4 text-primary"><field name="total_lineas_sum" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">EXCESOS DATA / ROAMING</span>
                                <strong class="fs-4 text-warning"><field name="count_excesos"/> línea(s)</strong>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Información General Factura">
                            <field name="proveedor" string="Proveedor"/>
                            <field name="fecha_factura" string="Fecha de Factura"/>
                            <field name="fecha_factura_str" string="Mes / Fecha de Factura" readonly="1"/>
                            <field name="fecha_subida" string="Fecha de Subida"/>
                            <field name="archivo_pdf" filename="pdf_filename" widget="binary"/>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Rubros Generales de Factura Claro">
                            <field name="renta_mensual" widget="monetary" readonly="estado != 'draft'" string="Renta Mensual Planes"/>
                            <field name="renta_otros_servicios" widget="monetary" readonly="estado != 'draft'" string="Renta Otros Servicios"/>
                            <field name="uso_data_movil" widget="monetary" readonly="estado != 'draft'" string="Uso Data Móvil"/>
                            <field name="llamadas_roaming" widget="monetary" readonly="estado != 'draft'" string="Llamadas Roaming / LD"/>
                            <field name="otros_cargos_creditos" widget="monetary" readonly="estado != 'draft'" string="Otros cargos, créditos o descuentos"/>
                            <field name="subtotal_factura" widget="monetary" readonly="1" string="Subtotal Factura" class="fw-bold"/>
                        </group>
                    </group>

                    <group string="Impuestos Aplicados y Desglose CDT (República Dominicana)">
                        <group string="Bases Gravables y Exclusiones CDT">
                            <field name="ajustes_excluidos_cdt" widget="monetary" readonly="estado != 'draft'" string="(-) Conceptos Excluidos CDT" help="Monto de conceptos como Cargo por Pago Atrasado / Moras que NO gravan 2% de CDT."/>
                            <field name="base_gravable_cdt" widget="monetary" readonly="1" class="fw-bold text-primary" string="(=) Base Gravable CDT"/>
                        </group>
                        <group string="Impuestos Calculados">
                            <field name="itbis_monto" widget="monetary" readonly="estado != 'draft'" string="ITBIS (18%)"/>
                            <field name="cdt_monto" widget="monetary" readonly="estado != 'draft'" class="fw-bold text-success" string="CDT (2%)"/>
                            <field name="isc_monto" widget="monetary" readonly="estado != 'draft'" string="ISC (10%)"/>
                        </group>
                    </group>

                    <!-- BANNER INFORMATIVO DE CONCILIACIÓN NIVEL CUENTA VS LÍNEAS -->
                    <field name="banner_conciliacion_html" widget="html" readonly="1" class="mb-3"/>

                    <!-- TABLA DE MOVIMIENTOS PROTAGONISTA CON ORDEN SOLICITADO -->
                    <notebook class="mt-4">
                        <page string="Desglose por empleado" name="lineas">
                            <div class="d-flex justify-content-end mb-2">
                                <button name="action_buscar_lineas_empleado" string="🔍 Buscar por Empleado o Número" type="object" class="btn-secondary"/>
                            </div>
                            <field name="linea_ids" readonly="estado != 'draft'">
                                <list string="Líneas de Factura" editable="bottom" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming', 'exceso_data_roaming']" decoration-danger="estado_linea == 'desconocido'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="empleado_id" string="Nombre Empleado" optional="show" readonly="conciliacion_id.estado != 'draft'" options="{'no_create': True}"/>
                                    <field name="numero_flota" string="Número Flota" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="cargo" string="Cargo" optional="show" readonly="1"/>

                                    <field name="otros_servicios_datos" string="Otros servicios y datos" widget="monetary" sum="Total otros servicios y datos" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="uso_local_data_movil" string="Uso local y data móvil" widget="monetary" sum="Total uso local y data móvil" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="llamadas_roaming_otras_llamadas" string="Llamadas, roaming y otras llamadas" widget="monetary" sum="Total llamadas y roaming" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="financiamiento_equipos" string="Financiamiento de equipos" widget="monetary" sum="Total financiamiento" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="otros_cargos_descuentos" string="Otros cargos y descuentos" widget="monetary" sum="Total cargos y descuentos" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="impuestos" string="Impuestos" widget="monetary" sum="Total impuestos" optional="show" readonly="conciliacion_id.estado != 'draft'"/>
                                    <field name="total" string="Total" widget="monetary" sum="Total" optional="show" readonly="1"/>
                                    <field name="estado_linea" string="Estado Línea" widget="badge" decoration-success="estado_linea=='ok'" decoration-info="estado_linea=='sin_consumo'" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming', 'exceso_data_roaming']" decoration-danger="estado_linea=='desconocido'" optional="show" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Consolidado por departamento" name="resumen_depto">
                            <field name="resumen_depto_ids" readonly="1">
                                <list string="Resumen por Departamento" create="false" delete="false" edit="false">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="departamento_id" optional="show"/>
                                    <field name="ubicacion_id" optional="show"/>
                                    <field name="cantidad_empleados" optional="show"/>
                                    <field name="monto_subtotal" widget="monetary" optional="show"/>
                                    <field name="monto_total" widget="monetary" optional="show"/>
                                    <field name="porcentaje_gasto" widget="percentage" optional="show"/>
                                </list>
                                <form string="Resumen por Departamento">
                                    <sheet>
                                        <group>
                                            <group string="Información General">
                                                <field name="conciliacion_id" readonly="1"/>
                                                <field name="departamento_id" readonly="1"/>
                                                <field name="ubicacion_id" readonly="1"/>
                                                <field name="cantidad_empleados" readonly="1"/>
                                            </group>
                                            <group string="Consumo y Participación">
                                                <field name="currency_id" invisible="1"/>
                                                <field name="monto_subtotal" widget="monetary" readonly="1"/>
                                                <field name="monto_total" widget="monetary" readonly="1"/>
                                                <field name="porcentaje_gasto" widget="percentage" readonly="1"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Observaciones / Notas" name="notes">
                            <field name="notes" placeholder="Notas de conciliación o aclaraciones de auditoría..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_flota_factura_conciliacion_search" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.search</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <search string="Buscar Conciliaciones">
                <field name="name"/>
                <field name="periodo"/>
                <field name="proveedor"/>
                <filter name="conciliado" string="Conciliados" domain="[('estado', '=', 'conciliado')]"/>
                <filter name="draft" string="Borrador / Procesando" domain="[('estado', 'in', ['draft', 'procesando'])]"/>
                <group>
                    <filter name="group_periodo" string="Periodo" context="{'group_by': 'periodo'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- LIST VIEW: buscador de líneas por empleado / número (usado por el botón "Buscar por Empleado o Número") -->
    <record id="view_flota_factura_linea_list" model="ir.ui.view">
        <field name="name">flota.factura.linea.list.buscador</field>
        <field name="model">flota.factura.linea</field>
        <field name="arch" type="xml">
            <list string="Líneas de Factura" editable="bottom" create="false" delete="false" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming', 'exceso_data_roaming']" decoration-danger="estado_linea == 'desconocido'">
                <field name="currency_id" column_invisible="1"/>
                <field name="conciliacion_id" column_invisible="1"/>
                <field name="empleado_id" string="Nombre Empleado" readonly="conciliacion_id.estado != 'draft'" options="{'no_create': True}"/>
                <field name="numero_flota" string="Número Flota" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="cargo" string="Cargo" readonly="1"/>
                <field name="otros_servicios_datos" string="Otros servicios y datos" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="uso_local_data_movil" string="Uso local y data móvil" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="llamadas_roaming_otras_llamadas" string="Llamadas, roaming y otras llamadas" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="financiamiento_equipos" string="Financiamiento de equipos" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="otros_cargos_descuentos" string="Otros cargos y descuentos" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="impuestos" string="Impuestos" widget="monetary" readonly="conciliacion_id.estado != 'draft'"/>
                <field name="total" string="Total" widget="monetary" readonly="1"/>
                <field name="estado_linea" string="Estado Línea" widget="badge" decoration-success="estado_linea=='ok'" decoration-info="estado_linea=='sin_consumo'" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming', 'exceso_data_roaming']" decoration-danger="estado_linea=='desconocido'" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW: buscador combinado por nombre de empleado o por número de flota -->
    <record id="view_flota_factura_linea_search" model="ir.ui.view">
        <field name="name">flota.factura.linea.search.buscador</field>
        <field name="model">flota.factura.linea</field>
        <field name="arch" type="xml">
            <search string="Buscar por Empleado o Número">
                <field name="empleado_id" string="Empleado o Número"
                       filter_domain="['|', ('empleado_id.name', 'ilike', self), ('numero_flota', 'ilike', self)]"/>
                <field name="numero_flota" string="Número Flota"/>
                <field name="departamento_id"/>
                <field name="conciliacion_id" string="Factura"/>
                <filter name="no_registrados" string="No Registrados" domain="[('estado_linea', '=', 'desconocido')]"/>
                <group>
                    <filter name="group_departamento" string="Departamento" context="{'group_by': 'departamento_id'}"/>
                    <filter name="group_estado" string="Estado Línea" context="{'group_by': 'estado_linea'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_flota_factura_conciliacion" model="ir.actions.act_window">
        <field name="name">Conciliación de Facturas Claro</field>
        <field name="res_model">flota.factura.conciliacion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flota_factura_conciliacion_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay conciliaciones registradas aún.
            </p>
            <p>
                Las facturas procesadas nativamente o importadas se registrarán aquí con su desglose por empleado y departamento.
            </p>
        </field>
    </record>

    <!-- MENU ITEMS -->
    <menuitem id="menu_flota_factura_root" name="Conciliación Facturas" parent="menu_flota_root" sequence="25"/>
    <menuitem id="menu_flota_factura_conciliacion" name="Facturas Claro" parent="menu_flota_factura_root" action="action_flota_factura_conciliacion" sequence="10"/>
</odoo>
