<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Factura Conciliación -->
    <record id="seq_flota_factura_conciliacion" model="ir.sequence">
        <field name="name">Secuencia Factura Conciliación Flota</field>
        <field name="code">flota.factura.conciliacion</field>
        <field name="prefix">FAC-CLARO/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_flota_factura_conciliacion_list" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.list</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <list string="Conciliaciones de Factura Claro" decoration-info="estado=='procesando'" decoration-success="estado=='conciliado'" decoration-danger="estado=='error'">
                <field name="name"/>
                <field name="periodo"/>
                <field name="proveedor" string="Proveedor"/>
                <field name="fecha_factura" string="Fecha"/>
                <field name="count_lineas"/>
                <field name="count_excesos" widget="badge" decoration-warning="count_excesos &gt; 0"/>
                <field name="subtotal" widget="monetary" sum="Subtotal Total"/>
                <field name="itbis_monto" widget="monetary" sum="ITBIS Total"/>
                <field name="cdt_monto" widget="monetary" sum="CDT Total"/>
                <field name="isc_monto" widget="monetary" sum="ISC Total"/>
                <field name="total_mes" widget="monetary" sum="Gran Total"/>
                <field name="estado" widget="badge" decoration-info="estado=='procesando'" decoration-success="estado=='conciliado'" decoration-danger="estado=='error'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW (ANCHO COMPLETO Y ORDEN SOLICITADO) -->
    <record id="view_flota_factura_conciliacion_form" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.form</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <form string="Conciliación Financiera Factura Claro">
                <header>
                    <button name="action_procesar_pdf_nativo" string="Extraer y Conciliar PDF Nativo" type="object" class="btn-success shadow-sm" invisible="not archivo_pdf"/>
                    <button name="action_exportar_excel" string="Exportar a Excel (.xlsx)" type="object" class="btn-info text-white shadow-sm"/>
                    <button name="action_generar_resumen_departamentos" string="Re-Consolidar Departamentos" type="object" class="btn-secondary"/>
                    <button name="action_marcar_conciliado" string="Marcar como Conciliado" type="object" class="btn-primary" invisible="estado == 'conciliado'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="draft,procesando,conciliado"/>
                </header>
                <sheet class="o_full_width">
                    <div class="oe_title mb-3">
                        <label for="name" class="oe_edit_only" string="Referencia de Factura"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="periodo" placeholder="AAAA-MM (Ej. 2026-09)"/>
                        </h3>
                    </div>

                    <!-- BANNER KPIS SUPERIOR -->
                    <div class="row text-center mb-4 g-2">
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">SUBTOTAL FACTURA</span>
                                <strong class="fs-4 text-primary"><field name="subtotal" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">IMPUESTOS (18%+2%+10%)</span>
                                <strong class="fs-4 text-info"><field name="itbis_monto" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">TOTAL DEL MES</span>
                                <strong class="fs-4 text-success"><field name="total_mes" widget="monetary"/></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <span class="text-muted d-block small">EXCESOS DATA / ROAMING</span>
                                <strong class="fs-4 text-warning"><field name="count_excesos"/> línea(s)</strong>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Información General Factura">
                            <field name="proveedor" string="Proveedor"/>
                            <field name="fecha_factura" string="Fecha"/>
                            <field name="archivo_pdf" filename="pdf_filename" widget="binary"/>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Rubros Generales de Factura Claro">
                            <field name="renta_mensual" widget="monetary"/>
                            <field name="renta_otros_servicios" widget="monetary"/>
                            <field name="uso_data_movil" widget="monetary"/>
                            <field name="llamadas_roaming" widget="monetary"/>
                            <field name="otros_cargos_creditos" widget="monetary"/>
                        </group>
                    </group>

                    <group string="Impuestos Aplicados (República Dominicana)">
                        <group>
                            <field name="subtotal" widget="monetary" readonly="1"/>
                            <field name="itbis_monto" widget="monetary" readonly="1" string="ITBIS (18%)"/>
                        </group>
                        <group>
                            <field name="cdt_monto" widget="monetary" readonly="1" string="CDT (2%)"/>
                            <field name="isc_monto" widget="monetary" readonly="1" string="ISC (10%)"/>
                            <field name="total_mes" widget="monetary" readonly="1" class="fw-bold fs-5 text-success" string="TOTAL DEL MES"/>
                        </group>
                    </group>

                    <!-- TABLA DE MOVIMIENTOS PROTAGONISTA CON ORDEN SOLICITADO -->
                    <notebook class="mt-4">
                        <page string="Desglose por Empleado (Líneas Factura)" name="lineas">
                            <field name="linea_ids">
                                <list string="Líneas de Factura" editable="bottom" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming']" decoration-danger="estado_linea == 'desconocido'">
                                    <!-- 1. Empleado -->
                                    <field name="empleado_id" optional="show"/>
                                    <!-- 2. Número Flota -->
                                    <field name="numero_flota" optional="show"/>
                                    <!-- 3. Cargo -->
                                    <field name="cargo" optional="show"/>
                                    <!-- 4. Departamento -->
                                    <field name="departamento_id" optional="show"/>
                                    <!-- 5. Total Línea -->
                                    <field name="total_linea" widget="monetary" sum="Gran Total Líneas" optional="show"/>
                                    
                                    <!-- Columnas adicionales configuradas para selector de filtros (optional=hide) con sumas totales -->
                                    <field name="ubicacion_id" optional="hide"/>
                                    <field name="monto_renta_plan" widget="monetary" sum="Total Renta Plan" optional="hide"/>
                                    <field name="monto_otros_servicios" widget="monetary" sum="Total Otros Servicios" optional="hide"/>
                                    <field name="monto_uso_adicional" widget="monetary" sum="Total Uso Adicional" optional="hide"/>
                                    <field name="monto_roaming" widget="monetary" sum="Total Roaming / LD" optional="hide"/>
                                    <field name="monto_financiamiento" widget="monetary" sum="Total Financiamiento" optional="hide"/>
                                    <field name="monto_creditos" widget="monetary" sum="Total Créditos / Ajustes" optional="hide"/>
                                    <field name="subtotal_linea" widget="monetary" sum="Subtotal General Líneas" optional="hide"/>
                                    <field name="itbis_linea" widget="monetary" sum="Total ITBIS (18%)" optional="hide" string="ITBIS (18%)"/>
                                    <field name="cdt_linea" widget="monetary" sum="Total CDT (2%)" optional="hide" string="CDT (2%)"/>
                                    <field name="isc_linea" widget="monetary" sum="Total ISC (10%)" optional="hide" string="ISC (10%)"/>
                                    <field name="estado_linea" widget="badge" optional="hide" decoration-success="estado_linea=='ok'" decoration-info="estado_linea=='sin_consumo'" decoration-warning="estado_linea in ['exceso_data', 'exceso_roaming']" decoration-danger="estado_linea=='desconocido'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Consolidado por Departamento" name="resumen_depto">
                            <field name="resumen_depto_ids" readonly="1">
                                <list string="Resumen por Departamento">
                                    <field name="departamento_id" optional="show"/>
                                    <field name="ubicacion_id" optional="show"/>
                                    <field name="cantidad_empleados" sum="Total Empleados" optional="show"/>
                                    <field name="monto_subtotal" widget="monetary" sum="Total Subtotal" optional="show"/>
                                    <field name="monto_total" widget="monetary" sum="Total General" optional="show"/>
                                    <field name="porcentaje_gasto" widget="percentage" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Observaciones / Notas" name="notes">
                            <field name="notes" placeholder="Notas de conciliación o aclaraciones de auditoría..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_flota_factura_conciliacion_search" model="ir.ui.view">
        <field name="name">flota.factura.conciliacion.search</field>
        <field name="model">flota.factura.conciliacion</field>
        <field name="arch" type="xml">
            <search string="Buscar Conciliaciones">
                <field name="name"/>
                <field name="periodo"/>
                <field name="proveedor"/>
                <filter name="conciliado" string="Conciliados" domain="[('estado', '=', 'conciliado')]"/>
                <filter name="draft" string="Borrador / Procesando" domain="[('estado', 'in', ['draft', 'procesando'])]"/>
                <group>
                    <filter name="group_periodo" string="Periodo" context="{'group_by': 'periodo'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_flota_factura_conciliacion" model="ir.actions.act_window">
        <field name="name">Conciliación de Facturas Claro</field>
        <field name="res_model">flota.factura.conciliacion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flota_factura_conciliacion_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay conciliaciones registradas aún.
            </p>
            <p>
                Las facturas procesadas nativamente o importadas se registrarán aquí con su desglose por empleado y departamento.
            </p>
        </field>
    </record>

    <!-- MENU ITEMS -->
    <menuitem id="menu_flota_factura_root" name="Conciliación Facturas" parent="menu_flota_root" sequence="25"/>
    <menuitem id="menu_flota_factura_conciliacion" name="Facturas Claro" parent="menu_flota_factura_root" action="action_flota_factura_conciliacion" sequence="10"/>
</odoo>
