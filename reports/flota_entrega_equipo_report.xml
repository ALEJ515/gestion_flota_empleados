<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato de página: márgenes ajustados para que el contenido aproveche
         casi toda la hoja A4 en vez de dejar grandes espacios en blanco -->
    <record id="paperformat_flota_entrega_equipo" model="report.paperformat">
        <field name="name">Acta de Entrega de Equipos (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">9</field>
        <field name="margin_bottom">9</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_flota_entrega_equipo" model="ir.actions.report">
        <field name="name">Acta de Entrega de Equipos (PDF)</field>
        <field name="model">flota.entrega.equipo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_flota_empleados.report_flota_entrega_equipo</field>
        <field name="report_file">gestion_flota_empleados.report_flota_entrega_equipo</field>
        <field name="binding_model_id" ref="model_flota_entrega_equipo"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_flota_entrega_equipo"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_flota_entrega_equipo">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #1F2937; line-height: 1.35;">
                        <style>
                            .acta-tabla { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
                            .acta-tabla td, .acta-tabla th { border: 1px solid #9CA3AF; padding: 6px 9px; }
                            .acta-section { background-color: #1F3864; color: #FFFFFF; font-weight: bold; text-align: center; padding: 7px; font-size: 13px; }
                            .acta-label { font-weight: bold; background-color: #E5E7EB; width: 35%; }
                            .acta-th { background-color: #2F5496; color: #FFFFFF; text-align: center; font-size: 12px; padding: 7px 5px; }
                        </style>

                        <!-- ENCABEZADO DE CONTROL DOCUMENTAL -->
                        <table class="acta-tabla">
                            <tr>
                                <td rowspan="3" style="width: 25%; text-align: center; vertical-align: middle;">
                                    <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 70px; max-width: 100%;"/>
                                </td>
                                <td style="width: 40%; text-align: center; font-weight: bold;">FORMULARIO</td>
                                <td style="width: 15%; font-weight: bold;">CÓDIGO:</td>
                                <td style="width: 20%;"><span t-field="doc.codigo_formulario"/></td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">Recepción y Entrega de Equipos</td>
                                <td style="font-weight: bold;">VERSIÓN:</td>
                                <td><span t-field="doc.version_formulario"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Departamento de Tecnología</td>
                                <td style="font-weight: bold;">PÁGINA:</td>
                                <td>1 de 1</td>
                            </tr>
                        </table>

                        <h2 style="text-align: center; font-size: 18px; margin: 10px 0 14px 0; color: #1F3864;">
                            ACTA <span t-field="doc.name"/> — <span t-field="doc.empleado_id.name"/>
                        </h2>

                        <!-- DATOS ENTREGA -->
                        <table class="acta-tabla">
                            <tr><td colspan="2" class="acta-section">DATOS ENTREGA</td></tr>
                            <tr>
                                <td class="acta-label">Distribuidor/Vendedor</td>
                                <td><span t-field="doc.tipo_asignacion"/></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Preparado por:</td>
                                <td><span t-field="doc.preparado_por_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Ruta</td>
                                <td><span t-field="doc.ruta_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Localidad</td>
                                <td><span t-field="doc.ubicacion_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Recibido por (responsable):</td>
                                <td><span t-field="doc.recibido_por"/></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Núm. de teléfono (flota)</td>
                                <td><span t-field="doc.telefono_flota"/></td>
                            </tr>
                        </table>

                        <!-- DATOS FLOTA RECIBIDA POR TI -->
                        <table class="acta-tabla">
                            <tr><td colspan="2" class="acta-section">DATOS FLOTA RECIBIDA POR TI</td></tr>
                            <tr>
                                <td class="acta-label">Modelo:</td>
                                <td><span t-field="doc.equipo_recibido_modelo"/><t t-if="not doc.equipo_recibido_modelo">N/A</t></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Serial/IMEI:</td>
                                <td><span t-field="doc.equipo_recibido_serial"/><t t-if="not doc.equipo_recibido_serial">N/A</t></td>
                            </tr>
                        </table>

                        <!-- DATOS IMPRESORA -->
                        <table class="acta-tabla">
                            <tr><td colspan="2" class="acta-section">DATOS IMPRESORA</td></tr>
                            <tr>
                                <td class="acta-label">Modelo:</td>
                                <td><span t-field="doc.impresora_modelo"/><t t-if="not doc.impresora_modelo">N/A</t></td>
                            </tr>
                            <tr>
                                <td class="acta-label">Serial:</td>
                                <td><span t-field="doc.impresora_serial"/><t t-if="not doc.impresora_serial">N/A</t></td>
                            </tr>
                        </table>

                        <!-- DATOS DE EQUIPO NUEVO ENTREGADO (justo debajo de Datos Impresora) -->
                        <table class="acta-tabla">
                            <tr><td colspan="6" class="acta-section">DATOS DE EQUIPO NUEVO ENTREGADO</td></tr>
                            <tr>
                                <th class="acta-th">Tipo de Equipo</th>
                                <th class="acta-th">Marca</th>
                                <th class="acta-th">Modelo</th>
                                <th class="acta-th">Cant.</th>
                                <th class="acta-th">IMEI / Serial</th>
                                <th class="acta-th">Estado</th>
                            </tr>
                            <t t-foreach="doc.linea_ids" t-as="l">
                                <tr>
                                    <td><span t-field="l.tipo_equipo"/></td>
                                    <td><span t-field="l.marca"/></td>
                                    <td><span t-field="l.modelo"/></td>
                                    <td style="text-align: center;"><span t-field="l.cantidad"/></td>
                                    <td><span t-field="l.imei_serial"/></td>
                                    <td style="text-align: center;"><span t-field="l.estado_equipo"/></td>
                                </tr>
                            </t>
                        </table>

                        <!-- ESTADO / OBSERVACIONES: separado de la tabla anterior para que no se vea recortado -->
                        <t t-if="doc.linea_ids.filtered(lambda l: l.observaciones)">
                            <table class="acta-tabla">
                                <tr><td class="acta-section">ESTADO / OBSERVACIONES</td></tr>
                                <t t-foreach="doc.linea_ids" t-as="l">
                                    <t t-if="l.observaciones">
                                        <tr>
                                            <td>
                                                <strong><span t-field="l.tipo_equipo"/><t t-if="l.modelo"> — <span t-field="l.modelo"/></t>:</strong>
                                                <span t-field="l.observaciones"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </t>

                        <br/>

                        <!-- FIRMAS: etiqueta arriba, línea en blanco debajo para firma física -->
                        <table style="width: 100%; border: none; margin-top: 26px;">
                            <tr>
                                <td style="width: 50%; border: none; text-align: left; padding-right: 20px; font-size: 13px;">
                                    <div style="font-weight: bold;">Firma Representante IT</div>
                                    <div style="border-top: 1px solid #000; width: 92%; margin-top: 34px;">&#160;</div>
                                    <div style="font-size: 10px; color: #6B7280;">Nombre: <span t-field="doc.entregado_por"/></div>
                                </td>
                                <td style="width: 50%; border: none; text-align: left; padding-left: 20px; font-size: 13px;">
                                    <div style="font-weight: bold;">Recibido Por</div>
                                    <div style="border-top: 1px solid #000; width: 92%; margin-top: 34px;">&#160;</div>
                                    <div style="font-size: 10px; color: #6B7280;">Nombre: <span t-field="doc.recibido_por"/> — Fecha: <span t-field="doc.fecha"/></div>
                                </td>
                            </tr>
                        </table>

                        <br/>

                        <table style="width: 100%; border: none;">
                            <tr>
                                <td style="width: 65%; border: none; vertical-align: middle;">
                                    <p style="font-size: 13px;">
                                        Recibió usted la política de informática para el correcto uso de estos
                                        recursos tecnológicos:
                                        SI <t t-if="doc.recibio_politica == 'si'">☒</t><t t-else="">☐</t>&#160;&#160;
                                        NO <t t-if="doc.recibio_politica == 'no'">☒</t><t t-else="">☐</t>
                                    </p>
                                </td>
                                <td style="width: 35%; border: none; text-align: center;">
                                    <img t-if="doc.politica_qr_imagen" t-att-src="image_data_uri(doc.politica_qr_imagen)" style="width: 120px; height: 120px;"/>
                                    <img t-elif="doc.politica_qr_src" t-att-src="doc.politica_qr_src" style="width: 120px; height: 120px;"/>
                                    <div t-if="doc.politica_url" style="font-size: 10px;"><a t-att-href="doc.politica_url">Link Política de Informática</a></div>
                                </td>
                            </tr>
                        </table>

                        <table class="acta-tabla" style="margin-top: 8px;">
                            <tr>
                                <td style="text-align: justify; font-size: 11px; background-color: #F9FAFB;">
                                    <strong>Aceptación y responsabilidad.</strong>
                                    Mediante la firma de este documento, comprendo y asumo la responsabilidad que me confiere
                                    la asignación de los equipos aquí detallados y entiendo que la violación a cualquiera de
                                    las directivas establecidas en la Política de Informática, la cual he recibido, leído y
                                    entendido, puede conllevar a que la empresa revoque mis privilegios y tome acciones
                                    disciplinarias y/o legales de acuerdo con lo establecido en dicha política.
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

